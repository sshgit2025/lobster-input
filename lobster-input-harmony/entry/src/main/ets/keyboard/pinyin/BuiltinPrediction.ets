/**
 * 内置"下一词"联想词库(冷启动兜底)。
 * 移植自 Android: keyboard/pinyin/BuiltinPrediction.kt(数据逐条对齐)。纯逻辑,不依赖任何 @ohos/@kit 模块。
 *
 * 业界(SwiftKey/Gboard/搜狗)做法 = 预训练 bigram 静态库 + 用户自学习动态库 加权融合。
 * 完整方案应离线从语料(中文维基/rime-ice/万象)统计 bigram 并 mmap;此处先用一份
 * 高频口语搭配表做 MVP,保证新用户一上屏就有"猜你下一词",随后用户自学习增量优化。
 * 后续可把这张表替换为脚本生成的更大数据文件(见 docs/keyboard 方案)。
 */
export class BuiltinPrediction {

  /** 词 → 高频后继词(按常见度排序,靠前权重高)。 */
  static readonly table: Map<string, string[]> = BuiltinPrediction.buildTable();

  private static buildTable(): Map<string, string[]> {
    const m = new Map<string, string[]>();
