    m.set('你', ['好', '们', '的', '是', '在', '可以', '知道', '想', '要', '怎么', '呢']);
    m.set('他', ['们', '的', '是', '说', '在', '也']);
    m.set('她', ['们', '的', '是', '说', '在', '也']);
    m.set('我们', ['一起', '的', '可以', '公司', '都', '要', '去', '明天']);
    m.set('你们', ['的', '公司', '都', '可以', '好']);
    m.set('今天', ['天气', '晚上', '下午', '上午', '我', '的', '是', '很']);
    m.set('明天', ['见', '上午', '下午', '晚上', '我', '的', '再']);
    m.set('昨天', ['晚上', '的', '我', '已经']);
    m.set('晚上', ['好', '见', '一起', '我', '吃饭']);
    m.set('早上', ['好', '我', '起来']);
    m.set('中午', ['好', '吃饭', '一起', '休息']);
    m.set('谢谢', ['你', '大家', '了', '您', '啦']);
    m.set('感谢', ['你', '大家', '您', '信任']);
    m.set('请', ['问', '你', '您', '稍等', '帮', '多', '放心']);
    m.set('请问', ['一下', '有', '你', '是', '可以']);
    m.set('麻烦', ['你', '您', '了', '帮', '一下']);
    m.set('对不起', ['我', '了', '打扰']);
    m.set('不好意思', ['打扰', '我', '麻烦']);
    m.set('可以', ['的', '吗', '了', '帮', '试试']);
    m.set('可不可以', ['帮', '麻烦']);
    m.set('需要', ['的', '什么', '帮助', '我', '注意']);
    m.set('我想', ['问', '说', '要', '知道', '了解', '确认']);
    m.set('我是', ['说', '你', '的', '来']);
    m.set('这个', ['是', '的', '问题', '可以', '怎么']);
    m.set('那个', ['是', '的', '可以', '怎么']);
    m.set('什么', ['时候', '意思', '问题', '事', '情况']);
    m.set('怎么', ['样', '办', '了', '回事', '走']);
    m.set('为什么', ['呢', '不', '会', '要']);
    m.set('因为', ['我', '这', '他', '时间']);
    m.set('所以', ['我', '说', '现在', '要']);
    m.set('但是', ['我', '现在', '这', '还是']);
    m.set('如果', ['有', '你', '可以', '需要', '方便']);
    m.set('现在', ['我', '的', '可以', '就', '开始']);
    m.set('已经', ['好了', '完成', '收到', '处理', '发']);
    m.set('马上', ['到', '好', '处理', '就']);
    m.set('稍等', ['一下', '我', '片刻']);
    m.set('好的', ['谢谢', '我', '没问题', '收到']);
    m.set('没', ['问题', '关系', '事', '有']);
    m.set('没有', ['问题', '关系', '了', '时间']);
    m.set('祝', ['你', '您', '大家', '工作', '生活']);
    m.set('生日', ['快乐', '祝', '蛋糕']);
    m.set('新年', ['快乐', '好', '祝']);
    m.set('周末', ['愉快', '快乐', '休息']);
    m.set('工作', ['顺利', '的', '中', '上']);
    m.set('辛苦', ['了', '你', '大家']);
    m.set('加油', ['哦', '啊', '我们']);
    m.set('收到', ['了', '谢谢', '请']);
    m.set('确认', ['一下', '了', '收到']);
    m.set('联系', ['我', '你', '方式']);
    m.set('电话', ['号码', '联系', '给']);
    m.set('地址', ['是', '在', '发']);
    m.set('时间', ['是', '可以', '安排', '地点']);
    m.set('中国', ['人', '的', '移动', '银行']);
    m.set('北京', ['市', '的', '时间']);
    m.set('非常', ['好', '感谢', '高兴', '重要']);
    m.set('真的', ['吗', '很', '太', '是']);
    m.set('一起', ['去', '吃饭', '来', '走']);
