<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppFrameWindowStyle" TargetType="Window">
        <Setter Property="Width" Value="1080" />
        <Setter Property="Height" Value="720" />
        <Setter Property="Background" Value="{DynamicResource DsBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsFgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource DsBgBrush}"
                            BorderBrush="{DynamicResource DsLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusWindow}"
                            Effect="{DynamicResource DsShadowLgEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource DsBgSunkenBrush}"
                                    BorderBrush="{DynamicResource DsLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{TemplateBinding Title}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource DsFgMutedBrush}" />
                            </Border>
                            <ContentPresenter x:Name="PART_Content"
                                              Grid.Row="1"
                                              Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarShellStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DsBgSunkenBrush}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter x:Name="PART_Content"
                                              Margin="16,18,16,12"
                                              Content="{TemplateBinding Content}" />
                            <Rectangle Width="1"
                                       HorizontalAlignment="Right"
                                       Fill="{DynamicResource DsLineStrongBrush}"
                                       IsHitTestVisible="False"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageContainerShellStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{DynamicResource DsBgBrush}">
                        <ScrollViewer Style="{StaticResource DsScrollViewerStyle}">
                            <ContentPresenter x:Name="PART_Content"
                                              Margin="{StaticResource PageContentPadding}"
                                              Content="{TemplateBinding Content}" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalShellStyle" TargetType="ContentControl">
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DsBgElevBrush}"
                            BorderBrush="{DynamicResource DsLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusWindow}"
                            Effect="{DynamicResource DsShadowLgEffect}">
                        <ContentPresenter x:Name="PART_Content"
                                          Margin="20"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloaterShellStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DsBgElevBrush}"
                            BorderBrush="{DynamicResource DsLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusWindow}"
                            Effect="{DynamicResource DsShadowLgEffect}">
                        <ContentPresenter x:Name="PART_Content"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RecorderFloaterShellStyle" TargetType="ContentControl" BasedOn="{StaticResource FloaterShellStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="ResultFloaterShellStyle" TargetType="ContentControl" BasedOn="{StaticResource FloaterShellStyle}">
        <Setter Property="Width" Value="620" />
        <Setter Property="MaxHeight" Value="720" />
    </Style>

</ResourceDictionary>
