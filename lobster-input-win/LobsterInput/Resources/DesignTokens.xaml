<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dynamic color tokens: light + sand placeholders, rewritten by ThemeManager. -->
    <Color x:Key="DsBgColor">#FFF4EFE7</Color>
    <Color x:Key="DsBgElevColor">#FFFBF8F2</Color>
    <Color x:Key="DsBgSunkenColor">#FFECE5D8</Color>
    <Color x:Key="DsBgHoverColor">#0D5C4428</Color>
    <Color x:Key="DsBgActiveColor">#145C4428</Color>
    <Color x:Key="DsLineColor">#1A5C4428</Color>
    <Color x:Key="DsLineStrongColor">#2E5C4428</Color>
    <Color x:Key="DsFgColor">#FF2C2620</Color>
    <Color x:Key="DsFgMutedColor">#FF6B5F50</Color>
    <Color x:Key="DsFgSubtleColor">#FFA89C87</Color>
    <Color x:Key="DsFgFaintColor">#FFD8CFBE</Color>

    <Color x:Key="DsAccentColor">#FF9C7D5B</Color>
    <Color x:Key="DsAccentSoftColor">#1A9C7D5B</Color>
    <Color x:Key="DsAccentFgColor">#FFFFFFFF</Color>
    <Color x:Key="DsAccentRingColor">#389C7D5B</Color>

    <Color x:Key="DsSuccessColor">#FF16A34A</Color>
    <Color x:Key="DsWarningColor">#FFD97706</Color>
    <Color x:Key="DsDangerColor">#FFDC2626</Color>
    <Color x:Key="DsDangerSoftColor">#0FDC2626</Color>
    <Color x:Key="DsDangerRingColor">#33DC2626</Color>
    <Color x:Key="DsDangerActiveColor">#1FDC2626</Color>
    <Color x:Key="DsInfoColor">#FF2563EB</Color>

    <SolidColorBrush x:Key="DsBgBrush" Color="{DynamicResource DsBgColor}" />
    <SolidColorBrush x:Key="DsBgElevBrush" Color="{DynamicResource DsBgElevColor}" />
    <SolidColorBrush x:Key="DsBgSunkenBrush" Color="{DynamicResource DsBgSunkenColor}" />
    <SolidColorBrush x:Key="DsBgHoverBrush" Color="{DynamicResource DsBgHoverColor}" />
    <SolidColorBrush x:Key="DsBgActiveBrush" Color="{DynamicResource DsBgActiveColor}" />
    <SolidColorBrush x:Key="DsLineBrush" Color="{DynamicResource DsLineColor}" />
    <SolidColorBrush x:Key="DsLineStrongBrush" Color="{DynamicResource DsLineStrongColor}" />
    <SolidColorBrush x:Key="DsFgBrush" Color="{DynamicResource DsFgColor}" />
    <SolidColorBrush x:Key="DsFgMutedBrush" Color="{DynamicResource DsFgMutedColor}" />
    <SolidColorBrush x:Key="DsFgSubtleBrush" Color="{DynamicResource DsFgSubtleColor}" />
    <SolidColorBrush x:Key="DsFgFaintBrush" Color="{DynamicResource DsFgFaintColor}" />

    <SolidColorBrush x:Key="DsAccentBrush" Color="{DynamicResource DsAccentColor}" />
    <SolidColorBrush x:Key="DsAccentSoftBrush" Color="{DynamicResource DsAccentSoftColor}" />
    <SolidColorBrush x:Key="DsAccentFgBrush" Color="{DynamicResource DsAccentFgColor}" />
    <SolidColorBrush x:Key="DsAccentRingBrush" Color="{DynamicResource DsAccentRingColor}" />

    <SolidColorBrush x:Key="DsSuccessBrush" Color="{DynamicResource DsSuccessColor}" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="{DynamicResource DsWarningColor}" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="{DynamicResource DsDangerColor}" />
    <SolidColorBrush x:Key="DsDangerSoftBrush" Color="{DynamicResource DsDangerSoftColor}" />
    <SolidColorBrush x:Key="DsDangerRingBrush" Color="{DynamicResource DsDangerRingColor}" />
    <SolidColorBrush x:Key="DsDangerActiveBrush" Color="{DynamicResource DsDangerActiveColor}" />
    <SolidColorBrush x:Key="DsInfoBrush" Color="{DynamicResource DsInfoColor}" />

    <DropShadowEffect x:Key="DsShadowSmEffect"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="1"
                      BlurRadius="2"
                      Opacity="0.04" />
    <DropShadowEffect x:Key="DsShadowMdEffect"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="4"
                      BlurRadius="16"
                      Opacity="0.06" />
    <DropShadowEffect x:Key="DsShadowLgEffect"
                      Color="#000000"
                      Direction="270"
                      ShadowDepth="24"
                      BlurRadius="48"
                      Opacity="0.18" />

    <!-- Radius tokens. -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusScrollThumb">2</CornerRadius>
    <sys:Double x:Key="RadiusXsValue">4</sys:Double>
    <sys:Double x:Key="RadiusSmValue">6</sys:Double>
    <sys:Double x:Key="RadiusMdValue">8</sys:Double>
    <sys:Double x:Key="RadiusLgValue">12</sys:Double>
    <sys:Double x:Key="RadiusXlValue">16</sys:Double>
    <sys:Double x:Key="RadiusWindowValue">14</sys:Double>
    <sys:Double x:Key="RadiusPillValue">999</sys:Double>

    <!-- Legacy static token aliases consumed by existing CyberTheme styles. -->
    <sys:Double x:Key="SidebarWidth">220</sys:Double>
    <sys:Double x:Key="WindowWidth">1080</sys:Double>
    <sys:Double x:Key="WindowHeight">720</sys:Double>
    <sys:Double x:Key="CornerRadius">12</sys:Double>
    <sys:Double x:Key="CornerRadiusSm">8</sys:Double>
    <CornerRadius x:Key="CardCorner">12</CornerRadius>
    <CornerRadius x:Key="SmallCorner">8</CornerRadius>
    <CornerRadius x:Key="ButtonCorner">8</CornerRadius>
    <Thickness x:Key="CardPadding">22,16</Thickness>
    <Thickness x:Key="SectionPadding">20</Thickness>

    <!-- Typography. -->
    <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, JetBrains Mono, monospace</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">13.5</sys:Double>
    <sys:Double x:Key="FontSizeDescription">12</sys:Double>
    <sys:Double x:Key="FontSizeSubtle">11</sys:Double>
    <sys:Double x:Key="FontSizeKbd">11</sys:Double>
    <sys:Double x:Key="FontSizeModalTitle">15</sys:Double>
    <sys:Double x:Key="LineHeightTight">1.4</sys:Double>
    <sys:Double x:Key="LineHeightBody">1.55</sys:Double>
    <sys:Double x:Key="LineHeightBodyRelaxed">1.65</sys:Double>
    <sys:Double x:Key="LineHeightDescription">1.5</sys:Double>
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>

    <!-- Spacing. -->
    <Thickness x:Key="Space2">2</Thickness>
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space6">6</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space10">10</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space14">14</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space18">18</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space28">28</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="PageHeaderPadding">32,24,32,16</Thickness>
    <Thickness x:Key="PageContentPadding">32,4,32,32</Thickness>
    <sys:Double x:Key="MainPageContentWidth">796</sys:Double>
    <sys:Double x:Key="MainPageCompactContentWidth">760</sys:Double>
    <Thickness x:Key="MainPageHeaderMargin">32,22,32,0</Thickness>
    <Thickness x:Key="MainPageTitleTopMargin">0</Thickness>
    <Thickness x:Key="MainPageContentMargin">32,20,32,40</Thickness>

    <!-- Motion. WPF has no cubic-bezier equivalent, so CubicEase carries the named contract. -->
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut" />
    <Duration x:Key="DurationHover">0:0:0.12</Duration>
    <Duration x:Key="DurationFast">0:0:0.16</Duration>
    <Duration x:Key="DurationScale">0:0:0.22</Duration>
    <Duration x:Key="DurationFade">0:0:0.28</Duration>
    <Duration x:Key="DurationSlide">0:0:0.32</Duration>

</ResourceDictionary>
