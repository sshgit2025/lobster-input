<Application x:Class="LobsterInput.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LobsterInput.Converters"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
                <ResourceDictionary Source="Resources/Animations.xaml" />
                <ResourceDictionary Source="Resources/WindowsChrome.xaml" />
                <ResourceDictionary Source="Resources/AtomicComponents.xaml" />
                <ResourceDictionary Source="Resources/LayoutShells.xaml" />
                <ResourceDictionary Source="Resources/CyberTheme.xaml" />
                <ResourceDictionary Source="Resources/LegacyAliases.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
