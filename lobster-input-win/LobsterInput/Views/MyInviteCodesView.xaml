<UserControl x:Class="LobsterInput.Views.MyInviteCodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="560" d:DesignHeight="500"
             Background="{DynamicResource DsBgBrush}">

    <ContentControl Style="{StaticResource PageContainerShellStyle}">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizePageTitle}"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       Foreground="{DynamicResource DsFgBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="DescText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeDescription}"
                       Foreground="{DynamicResource DsFgMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="LoadingText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeDescription}"
                       Foreground="{DynamicResource DsFgMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20"
                       Visibility="Collapsed"/>

            <ScrollViewer MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CodesList"/>
            </ScrollViewer>

            <TextBlock x:Name="ErrorText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeDescription}"
                       Foreground="{DynamicResource DsDangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </ContentControl>
</UserControl>
