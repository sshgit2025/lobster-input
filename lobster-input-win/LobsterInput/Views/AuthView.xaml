<UserControl x:Class="LobsterInput.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="680" d:DesignHeight="642"
             Background="{DynamicResource DsBgBrush}">

    <Grid>
        <ScrollViewer Style="{StaticResource DsScrollViewerStyle}">
            <StackPanel Width="420" HorizontalAlignment="Center" Margin="0,54,0,34">
                <Border Width="68"
                        Height="68"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18"
                        Background="{DynamicResource DsBgElevBrush}"
                        BorderBrush="{DynamicResource DsLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXl}">
                    <Image Source="pack://application:,,,/LobsterInput;component/Resources/Images/lobster.png"
                           Width="48"
                           Height="48"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="24"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource DsFgBrush}" />
                <TextBlock x:Name="SubtitleText"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,32"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeDescription}"
                           Foreground="{DynamicResource DsFgMutedBrush}" />

                <TextBox x:Name="EmailBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DsInputTextBoxStyle}"
                         Height="40"
                         FontSize="15"
                         IsEnabled="{Binding CodeSent, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,0,12"/>

                <StackPanel Visibility="{Binding CodeSent, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Name="CodeBox"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DsInputTextBoxStyle}"
                             Height="40"
                             FontSize="15"
                             Margin="0,0,0,8"/>
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button x:Name="ResendBtn"
                                Style="{StaticResource DsButtonGhostStyle}"
                                Height="26"
                                Padding="8,0"
                                Command="{Binding SendCodeCommand}"
                                Visibility="{Binding CanResend, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Foreground="{DynamicResource DsFgSubtleBrush}"
                                   FontSize="{StaticResource FontSizeDescription}"
                                   Visibility="{Binding CanResend, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1}s)">
                                    <Binding Path="ResendCodeText"/>
                                    <Binding Path="ResendCountdown"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                        Margin="0,0,0,12"
                        Padding="12,10"
                        Background="{DynamicResource DsDangerSoftBrush}"
                        BorderBrush="{DynamicResource DsDangerRingBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="{StaticResource FontSizeDescription}"
                               Foreground="{DynamicResource DsDangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Button x:Name="SendCodeBtn"
                        Style="{StaticResource DsButtonPrimaryStyle}"
                        Command="{Binding SendCodeCommand}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Visibility="{Binding CodeSent, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid>
                        <TextBlock x:Name="SendCodeBtnText"
                                   HorizontalAlignment="Center"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource DsIndeterminateSpinnerStyle}"
                                     Width="24"
                                     Height="24"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Button>

                <Button x:Name="VerifyBtn"
                        Style="{StaticResource DsButtonPrimaryStyle}"
                        Command="{Binding VerifyCommand}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Visibility="{Binding CodeSent, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock x:Name="VerifyBtnText"
                                   HorizontalAlignment="Center"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource DsIndeterminateSpinnerStyle}"
                                     Width="24"
                                     Height="24"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Button>

                <Border HorizontalAlignment="Center"
                        Margin="0,22,0,12"
                        Padding="8,4"
                        Background="{DynamicResource DsBgElevBrush}"
                        BorderBrush="{DynamicResource DsLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource DsFgMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="AuthLanguageCombo"
                                  Width="176"
                                  Style="{StaticResource DsSelectComboBoxStyle}"
                                  BorderThickness="0"
                                  SelectionChanged="OnLanguageChanged"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="TermsLink"
                            Style="{StaticResource DsButtonGhostStyle}"
                            Height="26"
                            Padding="6,0"
                            Click="TermsLink_Click"/>
                    <TextBlock x:Name="AndText"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSubtle}"
                               Foreground="{DynamicResource DsFgSubtleBrush}"
                               Margin="2,0"/>
                    <Button x:Name="PrivacyLink"
                            Style="{StaticResource DsButtonGhostStyle}"
                            Height="26"
                            Padding="6,0"
                            Click="PrivacyLink_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
