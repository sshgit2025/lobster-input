<Window x:Class="LobsterInput.Views.Overlays.TipOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:LobsterInput.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="320" Height="56"
        ResizeMode="NoResize"
        x:Name="OverlayWindow">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.35" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootCard" Opacity="0"
            CornerRadius="10"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDimBrush}"
            BorderThickness="1"
            Padding="14,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="InfoIcon"
                       Grid.Column="0"
                       Text="{x:Static helpers:AppIcons.Info}"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="15"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <TextBlock x:Name="TipText" Grid.Column="1"
                       Text=""
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource AppFont}"
                       FontSize="13"
                       Foreground="{DynamicResource TextBrightBrush}"
                       VerticalAlignment="Center" />

            <!-- Close button -->
            <Button x:Name="CloseBtn" Grid.Column="2"
                    Click="CloseBtn_Click"
                    Width="24" Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Margin="8,0,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="2">
                                        <TextBlock Text="{x:Static helpers:AppIcons.Close}"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextGhostBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="#20FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
