<Window x:Class="LobsterInput.Views.Overlays.OpenClawTaskOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="Manual"
        Width="680"
        Height="520"
        MinWidth="520"
        MinHeight="360"
        ResizeMode="NoResize"
        x:Name="OverlayWindow">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootCard" Opacity="0"
                CornerRadius="{DynamicResource CardCorner}"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDimBrush}"
                BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="48"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border Width="26" Height="26"
                                CornerRadius="13"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentRingBrush}"
                                Margin="0,0,10,0">
                            <TextBlock x:Name="HeaderIcon"
                                       Text="&#xE756;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="OpenClaw"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrightBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="连接中"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,1,0,0" />
                        <TextBlock x:Name="ElapsedText"
                                   Text="0s"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextGhostBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,1,0,0" />
                    </StackPanel>

                    <Button x:Name="StopBtn" Grid.Column="1"
                            Click="StopBtn_Click"
                            Width="72" Height="30"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#16FF6B6B" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#24FF6B6B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="■"
                                       FontSize="10"
                                       Foreground="{DynamicResource DsDangerBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="停止"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DsDangerBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyBtn" Grid.Column="2"
                            Click="CopyBtn_Click"
                            Width="30" Height="28">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="CopyIcon" Text=""
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}" />
                    </Button>

                    <Button x:Name="CloseBtn" Grid.Column="3"
                            Click="CloseBtn_Click"
                            Width="30" Height="28"
                            Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#30FF6B6B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="CloseIcon" Text=""
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}" />
                    </Button>
                </Grid>

                <Grid Margin="14">
                    <ScrollViewer x:Name="MarkdownScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{DynamicResource DsScrollViewerStyle}">
                        <RichTextBox x:Name="MarkdownContent"
                                     IsReadOnly="True"
                                     Focusable="False"
                                     IsDocumentEnabled="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Foreground="{DynamicResource TextBrightBrush}"
                                     FontFamily="{DynamicResource AppFont}"
                                     FontSize="13"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Border x:Name="ResizeRight"
                Width="12"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="ResizeRight_MouseLeftButtonDown" />
        <Border x:Name="ResizeBottom"
                Height="12"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNS"
                MouseLeftButtonDown="ResizeBottom_MouseLeftButtonDown" />
        <Border x:Name="ResizeCorner"
                Width="32"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeCorner_MouseLeftButtonDown" />
    </Grid>
</Window>
