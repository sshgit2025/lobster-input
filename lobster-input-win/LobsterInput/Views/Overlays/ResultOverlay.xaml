<Window x:Class="LobsterInput.Views.Overlays.ResultOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Width="480"
        Height="220"
        MinWidth="360"
        MinHeight="180"
        MaxHeight="500"
        ResizeMode="NoResize"
        x:Name="OverlayWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
    <Border x:Name="RootCard" Opacity="0"
            CornerRadius="{DynamicResource CardCorner}"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDimBrush}"
            BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="46"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentRingBrush}"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="HeaderIcon"
                                   Text="&#xE8D2;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText"
                               Text=""
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CountdownText"
                               Text=""
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextGhostBrush}"
                               VerticalAlignment="Center"
                               Margin="10,1,0,0" />
                    <TextBlock x:Name="FooterStatus"
                               Text=""
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextGhostBrush}"
                               VerticalAlignment="Center"
                               Margin="10,1,0,0" />
                </StackPanel>

                <!-- Pin button -->
                <Button x:Name="PinBtn" Grid.Column="1"
                        Click="PinBtn_Click"
                        ToolTip=""
                        Width="30" Height="28">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#20FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="PinIcon" Text=""
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" />
                </Button>

                <!-- Copy button -->
                <Button x:Name="CopyBtn" Grid.Column="2"
                        Click="CopyBtn_Click"
                        ToolTip=""
                        Width="30" Height="28">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#20FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="CopyIcon" Text=""
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" />
                </Button>

                <!-- Close button -->
                <Button x:Name="CloseBtn" Grid.Column="3"
                        Click="CloseBtn_Click"
                        ToolTip=""
                        Width="30" Height="28"
                        Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#30FF6B6B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="CloseIcon" Text=""
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextDimBrush}" />
                </Button>
            </Grid>

            <!-- Content area -->
            <Grid Margin="14,10,14,10">
                <!-- Plain text content -->
                <TextBlock x:Name="PlainTextContent"
                           TextWrapping="Wrap"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="13"
                           Foreground="{DynamicResource TextBrightBrush}"
                           Visibility="Collapsed" />

                <!-- Markdown scrollable content -->
                <ScrollViewer x:Name="MarkdownScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{DynamicResource DsScrollViewerStyle}"
                              Visibility="Collapsed">
                    <RichTextBox x:Name="MarkdownContent"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 IsDocumentEnabled="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Foreground="{DynamicResource TextBrightBrush}"
                                 FontFamily="{DynamicResource AppFont}"
                                 FontSize="13"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
        <Border x:Name="ResizeRight"
                Width="12"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="ResizeRight_MouseLeftButtonDown" />
        <Border x:Name="ResizeBottom"
                Height="12"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNS"
                MouseLeftButtonDown="ResizeBottom_MouseLeftButtonDown" />
        <Border x:Name="ResizeCorner"
                Width="32"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeCorner_MouseLeftButtonDown" />
    </Grid>
</Window>
