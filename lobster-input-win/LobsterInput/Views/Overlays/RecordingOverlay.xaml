<Window x:Class="LobsterInput.Views.Overlays.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="172" Height="46"
        ResizeMode="NoResize"
        x:Name="OverlayWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2" />
        </Storyboard>

        <Storyboard x:Key="PulseGreen" RepeatBehavior="Forever" />
    </Window.Resources>

    <Border x:Name="RootCard" Opacity="0"
            CornerRadius="23"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDimBrush}"
            BorderThickness="1"
            Padding="14,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <Canvas Grid.Column="0"
                    x:Name="WaveCanvas"
                    Width="42" Height="16"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Margin="0,0,8,0">
                <Rectangle x:Name="Bar0" Canvas.Left="4"   Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.45" />
                <Rectangle x:Name="Bar1" Canvas.Left="10"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.56" />
                <Rectangle x:Name="Bar2" Canvas.Left="16"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.67" />
                <Rectangle x:Name="Bar3" Canvas.Left="22"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.78" />
                <Rectangle x:Name="Bar4" Canvas.Left="28"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.89" />
            </Canvas>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar x:Name="ProcessingSpinner"
                             Style="{StaticResource DsIndeterminateSpinnerStyle}"
                             Width="18"
                             Height="18"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource AccentRingBrush}"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="CenterIcon"
                           Text="&#xE720;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextDimBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="58" />
            </StackPanel>

            <Canvas Grid.Column="2"
                    x:Name="WaveCanvasRight"
                    Width="42" Height="16"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Margin="8,0,0,0">
                <Rectangle x:Name="Bar5" Canvas.Left="10"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.89" />
                <Rectangle x:Name="Bar6" Canvas.Left="16"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.78" />
                <Rectangle x:Name="Bar7" Canvas.Left="22"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.67" />
                <Rectangle x:Name="Bar8" Canvas.Left="28"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.56" />
                <Rectangle x:Name="Bar9" Canvas.Left="34"  Canvas.Bottom="0" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.45" />
            </Canvas>

            <Button x:Name="CloseBtn" Grid.ColumnSpan="3"
                    Click="CloseBtn_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Opacity="0"
                    ToolTip="" />
        </Grid>
    </Border>
</Window>
