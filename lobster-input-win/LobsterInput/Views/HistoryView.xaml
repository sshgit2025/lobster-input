<UserControl x:Class="LobsterInput.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="700"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource MainPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle"
                       Style="{DynamicResource DsPageTitleTextStyle}"
                       FontSize="22"
                       VerticalAlignment="Top"
                       Margin="{StaticResource MainPageTitleTopMargin}"/>
            <TextBlock x:Name="RecordCountText"
                       Grid.Column="1"
                       Style="{DynamicResource DsCaptionTextStyle}"
                       VerticalAlignment="Top"
                       Margin="{StaticResource MainPageTitleTopMargin}"
                       Foreground="{DynamicResource DsFgSubtleBrush}"/>
        </Grid>

        <!-- History Items List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Style="{DynamicResource DsScrollViewerStyle}">
            <StackPanel Width="{StaticResource MainPageCompactContentWidth}"
                        Margin="{StaticResource MainPageContentMargin}"
                        HorizontalAlignment="Center">
                <!-- Retention Settings -->
                <Border BorderBrush="{DynamicResource DsLineBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,10"
                        Padding="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="RetentionTitle"
                                       Style="{DynamicResource DsBodyTextStyle}"
                                       FontWeight="Medium"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="RetentionSubtitle"
                                       Style="{DynamicResource DsCaptionTextStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="PrivacyDesc"
                                       Style="{DynamicResource DsCaptionTextStyle}"
                                       Foreground="{DynamicResource DsFgSubtleBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="RetentionCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource DsSelectComboBoxStyle}"
                                  Width="112"
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnRetentionChanged"/>
                        <TextBlock x:Name="PrivacyNote" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Empty State -->
                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource DsSectionTitleStyle}"
                           Foreground="{DynamicResource DsFgFaintBrush}"
                           Margin="0,90,0,90"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="HistoryList"/>
                <Button x:Name="LoadMoreButton"
                        Style="{DynamicResource DsIconButtonStyle}"
                        Content="&#xE70D;"
                        FontFamily="{DynamicResource IconFont}"
                        FontSize="16"
                        Foreground="{DynamicResource DsAccentBrush}"
                        Padding="0"
                        Width="34"
                        Height="28"
                        Margin="0,12,0,8"
                        HorizontalAlignment="Center"
                        Click="OnLoadMoreClick"
                        Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
